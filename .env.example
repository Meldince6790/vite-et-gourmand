# =============================================================================
# Vite & Gourmand — environment template
# =============================================================================
# Copy this file to `.env` at the repository root:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically. Do NOT commit a real `.env`.
#
# Values below are for LOCAL development only. Before any real deployment,
# replace every secret with strong unique values (e.g. openssl rand -base64 32).
#
# IMPORTANT — MariaDB / Mongo auth & passwords are applied only on FIRST init
# of empty volumes. After changing credentials, recreate volumes:
#   docker compose down
#   docker volume rm vite-et-gourmand_mysql_data vite-et-gourmand_mongo_data
#   docker compose up -d
# =============================================================================

PORT=3000

# --- MariaDB
# From the host (without published DB ports), use docker compose exec.
# Inside Compose, the backend reaches MariaDB at host "mysql".
DB_HOST=localhost
DB_USER=vite_app
DB_PASSWORD=replace-with-strong-mariadb-app-password
DB_NAME=vite_gourmand
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-strong-mariadb-root-password

# --- MongoDB (Compose network — auth required)
MONGO_ROOT_USERNAME=mongo_root
MONGO_ROOT_PASSWORD=replace-with-strong-mongo-root-password
MONGO_APP_USERNAME=vite_mongo
MONGO_APP_PASSWORD=replace-with-strong-mongo-app-password
MONGO_DB_NAME=vite_gourmand
# Application URI (used by the backend container). authSource = app database.
MONGO_URI=mongodb://vite_mongo:replace-with-strong-mongo-app-password@mongo:27017/vite_gourmand?authSource=vite_gourmand

# --- Frontend (Vite build arg — embedded in the JS bundle at image build time)
VITE_API_URL=http://localhost:3000

# --- Backend public origins
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Auth secrets (REQUIRED)
JWT_SECRET=local-dev-only-replace-before-deploy
JWT_EXPIRES=24h

# --- Transactional email
EMAIL_PROVIDER=log
EMAIL_FROM="Vite & Gourmand <onboarding@resend.dev>"
CONTACT_TO=contact@example.com
RESEND_API_KEY=

# --- OpenRouteService (backend only)
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_MS=8000
CATERER_ADDRESS="1 rue du Traiteur, 33000 Bordeaux, France"
CATERER_LATITUDE=44.8378
CATERER_LONGITUDE=-0.5792
