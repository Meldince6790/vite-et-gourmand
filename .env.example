# =============================================================================
# Vite & Gourmand — environment template
# =============================================================================
# Copy this file to `.env` at the repository root:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically. Do NOT commit a real `.env`.
#
# Values below are for LOCAL development only. Before any real deployment,
# replace every secret and every localhost URL with production values.
# =============================================================================

PORT=3000

# --- MariaDB (local / Compose mysql service — left for existing local workflow)
DB_HOST=localhost
DB_USER=vite
DB_PASSWORD=vite
DB_NAME=vite_gourmand
DB_PORT=3306
MYSQL_ROOT_PASSWORD=rootchangeme

# --- MongoDB (Compose overrides MONGO_URI to mongodb://mongo:27017/vite_gourmand)
MONGO_URI=mongodb://localhost:27017/vite_gourmand

# --- Frontend (Vite build arg — embedded in the JS bundle at image build time)
# Local Docker: browser calls the published backend port on the host.
# Production: set to the public HTTPS API URL, then rebuild the frontend image.
VITE_API_URL=http://localhost:3000

# --- Backend public origins (no localhost in production)
# Must match the URL used in the browser for the SPA.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Auth secrets (REQUIRED — Compose refuses to start if missing)
# Local placeholder only. Before any shared or production use, replace with:
#   openssl rand -base64 48
JWT_SECRET=local-dev-only-replace-before-deploy
JWT_EXPIRES=24h

# --- Transactional email
# Local: EMAIL_PROVIDER=log (no network, RESEND_API_KEY unused)
# Production: EMAIL_PROVIDER=resend + real RESEND_API_KEY + verified EMAIL_FROM
EMAIL_PROVIDER=log
EMAIL_FROM="Vite & Gourmand <onboarding@resend.dev>"
CONTACT_TO=contact@example.com
RESEND_API_KEY=

# --- OpenRouteService (backend only — never expose to the frontend)
# Required for delivery estimation / fee calculation in real use.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_MS=8000
CATERER_ADDRESS="1 rue du Traiteur, 33000 Bordeaux, France"
CATERER_LATITUDE=44.8378
CATERER_LONGITUDE=-0.5792
