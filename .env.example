# Copy this file to .env at the repository root for Docker Compose
# and/or adapt values for local (non-Docker) development.
#
# Do not commit a real .env file.

PORT=3000

# Local (non-Docker) defaults — Docker Compose overrides DB_HOST and MONGO_URI
DB_HOST=localhost
DB_USER=vite
DB_PASSWORD=vite
DB_NAME=vite_gourmand
DB_PORT=3306

# Used by the mysql Compose service
MYSQL_ROOT_PASSWORD=rootchangeme

JWT_SECRET=change-me-dev-secret
JWT_EXPIRES=24h

# Local (non-Docker) Mongo — Docker Compose uses mongodb://mongo:27017/vite_gourmand
MONGO_URI=mongodb://localhost:27017/vite_gourmand

# Browser origin allowed by the API (same for local and Docker host access)
CORS_ORIGIN=http://localhost:5173

# Browser-facing API URL (must stay localhost when using published Compose ports)
VITE_API_URL=http://localhost:3000

# Transactional email (default: log — no network call, no API key required)
# Set EMAIL_PROVIDER=resend and a real RESEND_API_KEY only in local/private .env
EMAIL_PROVIDER=log
EMAIL_FROM="Vite & Gourmand <onboarding@resend.dev>"
CONTACT_TO=contact@example.com
RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173
