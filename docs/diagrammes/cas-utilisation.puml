@startuml cas-utilisation
left to right direction
title Cas d'utilisation — Vite & Gourmand (vue ECF)

'========================
' ACTEURS
'========================
actor Visiteur
actor Client
actor Employe
actor Administrateur

Client --|> Visiteur
Administrateur --|> Employe

'========================
' SYSTEME
'========================
rectangle "Vite & Gourmand" {

  '--- VISITEUR ---
  usecase "Consulter menus" as UC1
  usecase "Filtrer menus" as UC2
  usecase "Voir détail menu" as UC3
  usecase "Consulter avis validés" as UC15
  usecase "Consulter horaires / pages légales" as UC16
  usecase "Envoyer message (contact)" as UC4
  usecase "Créer compte" as UC5

  '--- CLIENT ---
  usecase "Se connecter" as UC6
  usecase "Gérer son profil" as UC17
  usecase "Estimer frais de livraison" as UC18
  usecase "Passer commande" as UC7
  usecase "Consulter / modifier / annuler ses commandes" as UC8
  usecase "Déposer un avis" as UC19

  '--- EMPLOYE ---
  usecase "Gérer commandes (statut, annulation)" as UC9
  usecase "Gérer menus et plats" as UC10
  usecase "Modérer avis" as UC11
  usecase "Gérer horaires" as UC12

  '--- ADMINISTRATEUR ---
  usecase "Gérer employés" as UC13
  usecase "Consulter statistiques" as UC14
}

'========================
' LIENS ACTEURS
'========================

Visiteur --> UC1
Visiteur --> UC2
Visiteur --> UC3
Visiteur --> UC15
Visiteur --> UC16
Visiteur --> UC4
Visiteur --> UC5

Client --> UC6
Client --> UC17
Client --> UC18
Client --> UC7
Client --> UC8
Client --> UC19

Employe --> UC9
Employe --> UC10
Employe --> UC11
Employe --> UC12

Administrateur --> UC13
Administrateur --> UC14

'========================
' RELATIONS
'========================

UC2 ..> UC1 : <<extend>>
UC3 ..> UC1 : <<extend>>
UC18 ..> UC7 : <<include>>
UC19 ..> UC8 : <<extend>>

note right of UC14
  Agrégats MongoDB
  (commandes / CA)
end note

@enduml
