@startuml DiagrammeClasses

title Diagramme de classes - Vite & Gourmand

left to right direction

skinparam classAttributeIconSize 0

' =====================
' Utilisateurs
' =====================

class Utilisateur {
    - utilisateur_id : int
    - email : string
    - password : string
    - nom : string
    - prenom : string
    - telephone : string
    - ville : string
    - pays : string
    - adresse_postale : string
}

class Role {
    - role_id : int
    - libelle : string
}

Utilisateur "0..*" -- "1" Role : possède


' =====================
' Catalogue
' =====================

class Menu {
    - menu_id : int
    - titre : string
    - nombre_personne_minimum : int
    - prix_par_personne : decimal
    - description : string
    - quantite_restante : int
}

class Theme {
    - theme_id : int
    - libelle : string
}

class Regime {
    - regime_id : int
    - libelle : string
}

class Plat {
    - plat_id : int
    - titre_plat : string
    - photo : blob
}

class Allergene {
    - allergene_id : int
    - libelle : string
}


' =====================
' Commandes
' =====================

class Commande {
    - commande_id : int
    - numero_commande : string
    - date_commande : date
    - date_prestation : date
    - heure_livraison : string
    - adresse_livraison : string
    - prix_menu : decimal
    - nombre_personne : int
    - prix_livraison : decimal
    - distance_km : decimal
    - informations_complementaires : string
    - statut : string
    - pret_materiel : boolean
    - restitution_materiel : boolean
}


' =====================
' Avis
' =====================

class Avis {
    - avis_id : int
    - note : int
    - description : string
    - statut : string
}


' =====================
' Horaire
' =====================

class Horaire {
    - horaire_id : int
    - jour : string
    - heure_ouverture : string
    - heure_fermeture : string
}


' =====================
' Associations
' =====================

Utilisateur "1" -- "0..*" Commande : effectue

Commande "0..*" -- "1" Menu : concerne

Utilisateur "1" -- "0..*" Avis : publie

Menu "0..*" -- "1" Theme : propose

Menu "0..*" -- "1" Regime : adapte

Menu "1..*" -- "0..*" Plat : propose

Plat "0..*" -- "0..*" Allergene : contient

@enduml